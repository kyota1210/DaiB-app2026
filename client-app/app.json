{
  "expo": {
    "name": "DaiB",
    "slug": "DaiB",
    "scheme": "daibapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-screen.png",
      "resizeMode": "cover",
      "backgroundColor": "#E8E6E1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kytm1210.daibapp2026",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "QRコードの読み取りや写真の撮影に使用します。",
        "NSPhotoLibraryUsageDescription": "投稿やプロフィール画像のために写真ライブラリへアクセスします。",
        "NSPhotoLibraryAddUsageDescription": "保存した画像を写真ライブラリに追加するために使用します。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.kytm1210.daibapp2026",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "このアプリはQRコードを読み取るためにカメラを使用します。"
        }
      ],
      "expo-font",
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "d02412c1-43d6-4f60-a872-6340172d44c1"
      }
    },
    "owner": "kyotamoriyama",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d02412c1-43d6-4f60-a872-6340172d44c1"
    }
  }
}
